NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:8443
# Runtime: use Supabase's transaction-mode pooler URL (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
# Prisma CLI: use Supabase's session-mode pooler URL (port 5432).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Supabase Auth server verification (use a publishable/anon key; never a secret key).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>