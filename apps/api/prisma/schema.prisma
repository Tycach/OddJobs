generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum AppRole {
  CONSUMER
  PROVIDER
  ADMIN
  SUPPORT
  PARTNER

  @@map("app_role")
}

enum AuthProvider {
  PHONE
  EMAIL

  @@map("auth_provider")
}

enum VerificationStatus {
  NOT_STARTED
  IN_REVIEW
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum ModerationReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED

  @@map("moderation_report_status")
}

enum AdCampaignStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("ad_campaign_status")
}

enum PolicyDocument {
  TERMS
  PRIVACY

  @@map("policy_document")
}

enum JobStatus {
  OPEN
  AWARDED
  IN_PROGRESS
  COMPLETION_PENDING
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  DISPUTED
  EXPIRED

  @@map("job_status")
}

enum JobLocationMode {
  ONSITE
  REMOTE
  FLEXIBLE

  @@map("job_location_mode")
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED

  @@map("quote_status")
}

enum JobPaymentStatus {
  AWAITING_PAYMENT
  REPORTED
  PAID
  DISPUTED
  REFUNDED

  @@map("job_payment_status")
}

enum JobPaymentMethod {
  CASH
  MANUAL_TRANSFER

  @@map("job_payment_method")
}

enum PlatformFeeStatus {
  DUE
  REPORTED
  RECEIVED
  DISPUTED

  @@map("platform_fee_status")
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  displayName       String               @map("display_name") @db.VarChar(120)
  avatarPath        String?              @map("avatar_path") @db.VarChar(300)
  status            UserStatus           @default(PENDING)
  identities        AuthIdentity[]
  roleAssignments   UserRoleAssignment[]
  sessions          Session[]
  providerProfile   ProviderProfile?
  customerVerification CustomerIdentityVerification?
  policyConsents    PolicyConsent[]
  customerJobs      Job[]                @relation("CustomerJobs")
  serviceListings   ServiceListing[]     @relation("ProviderListings")
  claimedListings   ServiceListing[]     @relation("CustomerClaims")
  serviceListingActivity ServiceListingActivity[]
  reviewsGiven      ServiceListingReview[] @relation("ReviewsGiven")
  reviewsReceived   ServiceListingReview[] @relation("ReviewsReceived")
  quotes            Quote[]
  paymentsAsCustomer JobPayment[]         @relation("PaymentCustomer")
  paymentsAsProvider JobPayment[]         @relation("PaymentProvider")
  paymentEvents       JobPaymentEvent[]
  messages          Message[]
  customerConversations JobConversation[] @relation("JobConversationCustomer")
  providerConversations JobConversation[] @relation("JobConversationProvider")
  serviceListingMessages ServiceListingMessage[] @relation("ServiceListingMessageSender")
  moderationReports ModerationReport[]
  enforcementActions AdminUserEnforcement[]
  marketplaceActivityEvents MarketplaceActivityEvent[]
  notifications     MarketplaceNotification[]
  savedProviders    SavedProvider[]         @relation("SavedProviders")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("users")
}

enum ListingStatus {
  OPEN
  CLAIMED
  IN_PROGRESS
  COMPLETION_PENDING
  COMPLETED
  CANCELLED

  @@map("listing_status")
}

model ServiceListing {
  id                   String        @id @default(uuid()) @db.Uuid
  publicReference      String        @unique(map: "service_listings_job_reference_key") @default(dbgenerated("('OJ-'::text || lpad(nextval('job_reference_seq'::regclass)::text, 10, '0'::text))")) @map("job_reference") @db.VarChar(13)
  providerId           String        @map("provider_id") @db.Uuid
  claimedByCustomerId  String?       @map("claimed_by_customer_id") @db.Uuid
  title                String        @db.VarChar(160)
  description          String        @db.VarChar(5000)
  category             String        @db.VarChar(80)
  locationLabel        String        @map("location_label") @db.VarChar(160)
  budgetMinor          BigInt?       @map("budget_minor")
  media                Json          @default("[]") @db.JsonB
  currency             String        @default("KES") @db.Char(3)
  status               ListingStatus @default(OPEN)
  claimExpiresAt       DateTime?     @map("claim_expires_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  provider             User          @relation("ProviderListings", fields: [providerId], references: [id], onDelete: Restrict)
  claimedByCustomer    User?         @relation("CustomerClaims", fields: [claimedByCustomerId], references: [id], onDelete: Restrict)
  activity              ServiceListingActivity[]
  reviews               ServiceListingReview[]
  messages              ServiceListingMessage[]

  @@index([status, category, createdAt])
  @@index([providerId, status, createdAt])
  @@index([claimedByCustomerId, status, createdAt])
  @@map("service_listings")
}

model ServiceListingActivity {
  id          String         @id @default(uuid()) @db.Uuid
  listingId   String         @map("listing_id") @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  action      String         @db.VarChar(80)
  metadata    Json           @default("{}") @db.JsonB
  requestId   String         @map("request_id") @db.VarChar(80)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  listing     ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("service_listing_activity")
}

model ServiceListingReview {
  id             String         @id @default(uuid()) @db.Uuid
  listingId      String         @map("listing_id") @db.Uuid
  reviewerUserId String         @map("reviewer_user_id") @db.Uuid
  revieweeUserId String         @map("reviewee_user_id") @db.Uuid
  rating         Int
  comment        String         @default("") @db.VarChar(2000)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  listing        ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer       User           @relation("ReviewsGiven", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  reviewee       User           @relation("ReviewsReceived", fields: [revieweeUserId], references: [id], onDelete: Restrict)

  @@unique([listingId, reviewerUserId])
  @@index([revieweeUserId, createdAt])
  @@index([reviewerUserId, createdAt])
  @@map("service_listing_reviews")
}

model ServiceListingMessage {
  id        String         @id @default(uuid()) @db.Uuid
  listingId String         @map("listing_id") @db.Uuid
  senderId  String         @map("sender_id") @db.Uuid
  body      String         @db.VarChar(5000)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  listing   ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender    User           @relation("ServiceListingMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@index([senderId, createdAt])
  @@map("service_listing_messages")
}

model AdminAuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String?  @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.VarChar(160)
  metadata    Json     @default("{}") @db.JsonB
  requestId   String   @map("request_id") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_events")
}

model PolicyConsent {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  document   PolicyDocument
  version    String         @db.VarChar(40)
  acceptedAt DateTime       @default(now()) @map("accepted_at") @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, document, version])
  @@index([userId, acceptedAt])
  @@map("policy_consents")
}

model AuthIdentity {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  provider   AuthProvider
  subject    String       @db.VarChar(320)
  verifiedAt DateTime?    @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

model UserRoleAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       AppRole
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, assignedAt])
  @@map("user_role_assignments")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model ProviderProfile {
  id                 String                       @id @default(uuid()) @db.Uuid
  userId             String                       @unique @map("user_id") @db.Uuid
  publicName         String                       @map("public_name") @db.VarChar(120)
  bio                String?                      @db.VarChar(2000)
  region             String?                      @db.VarChar(120)
  serviceLatitude    Float?                       @map("service_latitude")
  serviceLongitude   Float?                       @map("service_longitude")
  maxTravelDistanceKm Int                         @default(25) @map("max_travel_distance_km")
  payoutHoldAt        DateTime?                    @map("payout_hold_at") @db.Timestamptz(3)
  payoutHoldReason    String?                      @map("payout_hold_reason") @db.VarChar(1000)
  payoutHoldByUserId  String?                      @map("payout_hold_by_user_id") @db.Uuid
  verificationDocumentType String?                 @map("verification_document_type") @db.VarChar(40)
  verificationDocumentPath String?                 @map("verification_document_path") @db.VarChar(300)
  skillsEvidence     String?                       @map("skills_evidence") @db.VarChar(2000)
  verificationStatus VerificationStatus           @default(NOT_STARTED) @map("verification_status")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews            ProviderVerificationReview[]
  savedBy            SavedProvider[]

  @@index([verificationStatus, region])
  @@index([serviceLatitude, serviceLongitude])
  @@map("provider_profiles")
}

model SavedProvider {
  customerId       String          @map("customer_id") @db.Uuid
  providerProfileId String         @map("provider_profile_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  customer         User            @relation("SavedProviders", fields: [customerId], references: [id], onDelete: Cascade)
  providerProfile  ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@id([customerId, providerProfileId])
  @@index([providerProfileId, createdAt])
  @@map("saved_providers")
}

model CustomerIdentityVerification {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  documentType       String             @map("document_type") @db.VarChar(40)
  documentPath       String             @map("document_path") @db.VarChar(300)
  status             VerificationStatus @default(IN_REVIEW)
  submittedAt        DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId   String?            @map("reviewed_by_user_id") @db.Uuid
  reviewReason       String?            @map("review_reason") @db.VarChar(1000)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@map("customer_identity_verifications")
}

model ProviderVerificationReview {
  id                String             @id @default(uuid()) @db.Uuid
  providerProfileId String             @map("provider_profile_id") @db.Uuid
  actorUserId       String             @map("actor_user_id") @db.Uuid
  decision          VerificationStatus
  reason            String?            @db.VarChar(1000)
  requestId         String             @map("request_id") @db.VarChar(80)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  providerProfile   ProviderProfile    @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("provider_verification_reviews")
}

model ModerationReport {
  id               String                 @id @default(uuid()) @db.Uuid
  reporterUserId   String                 @map("reporter_user_id") @db.Uuid
  subjectType      String                 @map("subject_type") @db.VarChar(40)
  subjectId        String                 @map("subject_id") @db.VarChar(160)
  reason           String                 @db.VarChar(80)
  details          String                 @db.VarChar(2000)
  status           ModerationReportStatus @default(OPEN)
  decisionReason   String?                @map("decision_reason") @db.VarChar(1000)
  reviewedByUserId String?                @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  reporter         User                   @relation(fields: [reporterUserId], references: [id], onDelete: Restrict)
  enforcement      AdminUserEnforcement?

  @@index([status, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@map("moderation_reports")
}

model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  slug      String   @unique @db.VarChar(90)
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active, sortOrder, name])
  @@map("service_categories")
}

model AdminSetting {
  key       String   @id @db.VarChar(80)
  value     Json     @db.JsonB
  updatedBy String   @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admin_settings")
}

model AdCampaign {
  id             String           @id @default(uuid()) @db.Uuid
  advertiserId   String?          @map("advertiser_id") @db.Uuid
  advertiserName String           @map("advertiser_name") @db.VarChar(120)
  title          String           @db.VarChar(120)
  description    String           @db.VarChar(500)
  placement      String           @db.VarChar(40)
  destinationUrl String?          @map("destination_url") @db.VarChar(2048)
  status         AdCampaignStatus @default(PENDING)
  decisionReason String?          @map("decision_reason") @db.VarChar(1000)
  reviewedBy     String?          @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("ad_campaigns")
}

model AdminUserEnforcement {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  reportId    String    @unique @map("report_id") @db.Uuid
  actorUserId String    @map("actor_user_id") @db.Uuid
  reason      String    @db.VarChar(1000)
  releasedBy  String?   @map("released_by") @db.Uuid
  releasedAt  DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  report      ModerationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId, releasedAt])
  @@map("admin_user_enforcements")
}

model AdminMonitoringSnapshot {
  id                     String   @id @default(uuid()) @db.Uuid
  database               String   @db.VarChar(20)
  pendingVerifications   Int      @map("pending_verifications")
  openReports            Int      @map("open_reports")
  heapUsedBytes          BigInt   @map("heap_used_bytes")
  heapLimitBytes         BigInt   @map("heap_limit_bytes")
  alerts                 Json     @default("[]") @db.JsonB
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("admin_monitoring_snapshots")
}

model Job {
  id            String    @id @default(uuid()) @db.Uuid
  publicReference String  @unique(map: "jobs_job_reference_key") @default(dbgenerated("('OJ-'::text || lpad(nextval('job_reference_seq'::regclass)::text, 10, '0'::text))")) @map("job_reference") @db.VarChar(13)
  customerId    String    @map("customer_id") @db.Uuid
  title         String    @db.VarChar(160)
  description   String    @db.VarChar(5000)
  category      String    @db.VarChar(80)
  locationLabel String    @map("location_label") @db.VarChar(160)
  /// Integer minor currency units; the provider adapter converts to rail units.
  budgetMinor   BigInt?   @map("budget_minor")
  currency      String    @default("KES") @db.Char(3)
  status        JobStatus @default(OPEN)
  requestedFor  DateTime? @map("requested_for") @db.Timestamptz(3)
  applicationDeadlineAt DateTime? @map("application_deadline_at") @db.Timestamptz(3)
  dueAt         DateTime? @map("due_at") @db.Timestamptz(3)
  locationMode  JobLocationMode @default(ONSITE) @map("location_mode")
  locationLatitude Float? @map("location_latitude")
  locationLongitude Float? @map("location_longitude")
  shareExactLocationWithProvider Boolean @default(false) @map("share_exact_location_with_provider")
  completionNote String? @map("completion_note") @db.VarChar(5000)
  revisionNote String? @map("revision_note") @db.VarChar(2000)
  media         Json      @default("[]")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer      User      @relation("CustomerJobs", fields: [customerId], references: [id], onDelete: Restrict)
  quotes        Quote[]
  payment       JobPayment?
  messages      Message[]
  conversations JobConversation[]

  @@index([customerId, createdAt])
  @@index([status, category, createdAt])
  @@map("jobs")
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  jobId       String      @map("job_id") @db.Uuid
  providerId  String      @map("provider_id") @db.Uuid
  revision    Int         @default(1)
  /// Integer minor currency units; the provider adapter converts to rail units.
  amountMinor BigInt      @map("amount_minor")
  currency    String      @default("KES") @db.Char(3)
  message     String      @db.VarChar(2000)
  availability String     @default("") @db.VarChar(120)
  status      QuoteStatus @default(SUBMITTED)
  expiresAt   DateTime?   @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider    User        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  conversation JobConversation?
  payment      JobPayment?

  @@unique([jobId, providerId, revision])
  @@unique([jobId, providerId], where: { status: "SUBMITTED" }, map: "quotes_one_active_per_provider_per_job_key")
  @@unique([jobId], where: { status: "ACCEPTED" }, map: "quotes_one_accepted_per_job_key")
  @@index([jobId, status, createdAt])
  @@index([providerId, createdAt])
  @@map("quotes")
}

model JobPayment {
  id                    String            @id @default(uuid()) @db.Uuid
  paymentReference      String            @unique(map: "job_payments_payment_reference_key") @default(dbgenerated("('PAY-'::text || lpad(nextval('job_payment_reference_seq'::regclass)::text, 9, '0'::text))")) @map("payment_reference") @db.VarChar(13)
  jobId                 String            @unique @map("job_id") @db.Uuid
  quoteId               String            @unique @map("quote_id") @db.Uuid
  customerId            String            @map("customer_id") @db.Uuid
  providerId            String            @map("provider_id") @db.Uuid
  grossAmountMinor      BigInt            @map("gross_amount_minor")
  commissionBasisPoints Int               @map("commission_basis_points")
  commissionAmountMinor BigInt            @map("commission_amount_minor")
  providerAmountMinor   BigInt            @map("provider_amount_minor")
  currency              String            @default("KES") @db.Char(3)
  method                JobPaymentMethod?
  status                JobPaymentStatus  @default(AWAITING_PAYMENT)
  reportedByUserId      String?           @map("reported_by_user_id") @db.Uuid
  reportedAt            DateTime?         @map("reported_at") @db.Timestamptz(3)
  confirmedByUserId     String?           @map("confirmed_by_user_id") @db.Uuid
  confirmedAt           DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  platformFeeStatus    PlatformFeeStatus @default(DUE) @map("platform_fee_status")
  platformFeeReportedByUserId String?    @map("platform_fee_reported_by_user_id") @db.Uuid
  platformFeeReportedAt DateTime?        @map("platform_fee_reported_at") @db.Timestamptz(3)
  platformFeePaymentReference String?    @map("platform_fee_payment_reference") @db.VarChar(120)
  platformFeeReceivedAt DateTime?        @map("platform_fee_received_at") @db.Timestamptz(3)
  platformFeeReceiptReference String?   @map("platform_fee_receipt_reference") @db.VarChar(120)
  disputeReason         String?           @map("dispute_reason") @db.VarChar(1000)
  resolutionNote        String?           @map("resolution_note") @db.VarChar(1000)
  resolvedByUserId      String?           @map("resolved_by_user_id") @db.Uuid
  resolvedAt            DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  job                   Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  quote                 Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customer              User              @relation("PaymentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  provider              User              @relation("PaymentProvider", fields: [providerId], references: [id], onDelete: Restrict)
  events                JobPaymentEvent[]

  @@index([customerId, status, createdAt])
  @@index([providerId, status, createdAt])
  @@index([status, createdAt])
  @@map("job_payments")
}

model JobPaymentEvent {
  id        String     @id @default(uuid()) @db.Uuid
  paymentId String     @map("payment_id") @db.Uuid
  actorId   String?    @map("actor_id") @db.Uuid
  action    String     @db.VarChar(80)
  metadata  Json       @default("{}") @db.JsonB
  requestId String     @map("request_id") @db.VarChar(80)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  payment   JobPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([paymentId, action, requestId])
  @@index([paymentId, createdAt])
  @@map("job_payment_events")
}

model Message {
  id        String    @id @default(uuid()) @db.Uuid
  jobId     String    @map("job_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  body      String    @db.VarChar(5000)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  conversation JobConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model JobConversation {
  id         String   @id @default(uuid()) @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  quoteId    String?  @unique @map("quote_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer   User     @relation("JobConversationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  provider   User     @relation("JobConversationProvider", fields: [providerId], references: [id], onDelete: Restrict)
  quote      Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@unique([jobId, providerId])
  @@index([customerId, updatedAt])
  @@index([providerId, updatedAt])
  @@map("job_conversations")
}

model MarketplaceActivityEvent {
  id              String   @id @default(uuid()) @db.Uuid
  actorUserId     String   @map("actor_user_id") @db.Uuid
  actorRole       String   @map("actor_role") @db.VarChar(20)
  action          String   @db.VarChar(80)
  jobId           String   @map("job_id") @db.Uuid
  quoteId         String?  @map("quote_id") @db.Uuid
  metadata        Json     @default("{}") @db.JsonB
  requestId       String   @map("request_id") @db.VarChar(80)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor           User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([jobId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("marketplace_activity_events")
}

model MarketplaceNotification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String    @db.VarChar(60)
  title       String    @db.VarChar(160)
  body        String    @db.VarChar(500)
  jobId       String?   @map("job_id") @db.Uuid
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  dedupeKey   String    @unique @map("dedupe_key") @db.VarChar(180)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([userId, readAt, createdAt])
  @@map("marketplace_notifications")
}

model OutboxEvent {
  id              String    @id @default(uuid()) @db.Uuid
  eventType       String    @map("event_type") @db.VarChar(80)
  aggregateType   String    @map("aggregate_type") @db.VarChar(40)
  aggregateId     String?   @map("aggregate_id") @db.Uuid
  recipientUserId String?   @map("recipient_user_id") @db.Uuid
  payload         Json      @default("{}") @db.JsonB
  requestId       String    @map("request_id") @db.VarChar(80)
  dedupeKey       String    @unique @map("dedupe_key") @db.VarChar(180)
  status          String    @default("pending") @db.VarChar(20)
  attempts        Int       @default(0)
  availableAt     DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  lastError       String?   @map("last_error") @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}
